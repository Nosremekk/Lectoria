# =========================================================================
# Lectoria — Configuração de Ambiente (Exemplo para Produção / Linux Mint)
# Copie para .env ou utilize ./deployment/configure.sh para gerar este arquivo.
# =========================================================================

# Nome exibido na aplicação
LECTORIA_APP_NAME="Lectoria"

# Endereço e porta de escuta HTTP
# 0.0.0.0 permite acesso pelos dispositivos da rede local doméstica (LAN)
# A porta 8765 coexiste sem conflito com o Jellyfin (8096 / 8920)
LECTORIA_HOST="0.0.0.0"
LECTORIA_PORT="8765"

# Diretórios de armazenamento (podem ser caminhos absolutos no servidor destino)
# Se omitidos, utilizam as pastas books/, data/, data/covers/ e backups/ dentro do projeto.
# LECTORIA_LIBRARY_DIR="/home/usuario/Livros"
# LECTORIA_DATA_DIR="/home/usuario/lectoria/data"
# LECTORIA_COVERS_DIR="/home/usuario/lectoria/data/covers"
# LECTORIA_BACKUPS_DIR="/home/usuario/lectoria/backups"

# =========================================================================
# Segurança HTTP, Cookies, Proxies Confiáveis e CSP (Fase 11.3)
# =========================================================================
# Política de atributo Secure nos cookies de sessão e CSRF:
#   auto  (padrão): Secure=True apenas quando a requisição efetiva for HTTPS
#   true          : exige HTTPS (recomendado atrás de Tailscale Serve / Caddy / Nginx HTTPS)
#   false         : permite HTTP explicitamente (localhost / LAN / Tailscale HTTP)
# Aviso: HTTP não protege a confidencialidade do transporte, mesmo em redes privadas.
LECTORIA_SECURE_COOKIES="auto"

# IPs/CIDRs de proxies reversos autorizados a fornecer X-Forwarded-Proto e X-Forwarded-For.
# Padrão conservador: apenas loopback ("127.0.0.1,::1").
# Em Docker atrás de proxy no host (ex.: Tailscale Serve / Caddy), inclua a subnet da bridge
# (ex.: "127.0.0.1,::1,172.16.0.0/12") ou o IP específico do proxy. Evite "*".
LECTORIA_FORWARDED_ALLOW_IPS="127.0.0.1,::1"

# Content-Security-Policy nas páginas HTML (/ e /reader):
#   report-only (padrão): emite Content-Security-Policy-Report-Only para validação segura
#   enforce             : aplica Content-Security-Policy bloqueante
#   off                 : desativa CSP nas páginas HTML
LECTORIA_CSP_MODE="report-only"

# HTTP Strict Transport Security (HSTS) — desativado por padrão em instalações genéricas.
# Quando "true", é emitido apenas em requisições efetivamente HTTPS.
LECTORIA_HSTS_ENABLED="false"
