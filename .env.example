# =========================================================================
# Lectoria — Configuração de Ambiente (Exemplo para Produção / Linux Mint)
# Copie para .env ou utilize ./deployment/configure.sh para gerar este arquivo.
# =========================================================================

# Nome exibido na aplicação
LECTORIA_APP_NAME="Lectoria"

# Endereço e porta de escuta HTTP
# 0.0.0.0 permite acesso pelos dispositivos da rede local doméstica (LAN)
# A porta 8765 coexiste sem conflito com o Jellyfin (8096 / 8920)
LECTORIA_HOST="0.0.0.0"
LECTORIA_PORT="8765"

# Diretórios de armazenamento (podem ser caminhos absolutos no servidor destino)
# Se omitidos, utilizam as pastas books/, data/, data/covers/ e backups/ dentro do projeto.
# LECTORIA_LIBRARY_DIR="/home/usuario/Livros"
# LECTORIA_DATA_DIR="/home/usuario/lectoria/data"
# LECTORIA_COVERS_DIR="/home/usuario/lectoria/data/covers"
# LECTORIA_BACKUPS_DIR="/home/usuario/lectoria/backups"
