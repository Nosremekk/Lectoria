# Arquivo de unidade systemd para o Lectoria (Linux Mint XFCE / Ubuntu / Debian)
# Nota: Para instalação no servidor de destino, execute ./deployment/configure.sh
# para ajustar automaticamente User, Group, WorkingDirectory, ExecStart e ReadWritePaths
# de acordo com o usuário e diretório reais da máquina.

[Unit]
Description=Lectoria — Servidor Pessoal de Livros Digitais
Documentation=https://github.com/Nosremekk/Lectoria
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lectoria
Group=lectoria
WorkingDirectory=/opt/lectoria
EnvironmentFile=-/opt/lectoria/.env
ExecStart=/opt/lectoria/.venv/bin/python3 main.py

# Reinicialização automática controlada em caso de falha transitória
Restart=on-failure
RestartSec=5

# Variáveis de ambiente padrão (podem ser sobrescritas no arquivo .env)
Environment=PYTHONUNBUFFERED=1
Environment=LECTORIA_HOST=0.0.0.0
Environment=LECTORIA_PORT=8765
Environment=PORT=8765

# Logs integrados ao systemd journal (journalctl -u lectoria.service)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lectoria

# Diretivas de isolamento e segurança para hardware doméstico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/lectoria/data /opt/lectoria/backups

# Limites de recursos para proteger a coexistência com outros serviços (ex: Jellyfin)
MemoryMax=512M
CPUWeight=100

[Install]
WantedBy=multi-user.target
