[Unit]
Description=Atualização automática segura do Lectoria (Docker/OCI)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
# Opcional: personalize caminhos e canal via EnvironmentFile
EnvironmentFile=-/etc/default/lectoria-auto-update
ExecStart=/usr/local/sbin/lectoria-auto-update
TimeoutStartSec=15min
